# Copy to .env (gitignored). Never commit real credentials or paste them into chat/PRs.

# Dev app under test
E2E_BASE_URL=http://localhost:3000
# Page the app lands on after a successful login (used to detect "logged in")
E2E_AUTHENTICATED_PATH=/
# Protected page the smoke test opens to prove a saved session still works
E2E_SMOKE_PATH=/
# Path the app redirects to when the session is gone (pr-shots fails a shot that lands here)
E2E_LOGIN_PATH=/login

# Role slugs, comma-separated. Each slug needs <SLUG>_EMAIL / <SLUG>_PASSWORD below
# (slug upper-cased, '-' -> '_'). A role with an empty password is skipped by setup.
E2E_ROLES=admin,viewer

ADMIN_EMAIL=
ADMIN_PASSWORD=

VIEWER_EMAIL=
VIEWER_PASSWORD=
