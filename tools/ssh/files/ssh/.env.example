# Copy to .env (gitignored). One block per remote env; the env name is what you pass to rs.sh/svc.sh.
# Never paste real passwords into chat/PRs.

SSH_DEVELOP_HOST=user@dev-host
SSH_DEVELOP_PASS=
SSH_DEVELOP_RUNTIME=docker

SSH_STAGING_HOST=user@staging-host
SSH_STAGING_PASS=
SSH_STAGING_RUNTIME=k8s
SSH_STAGING_NAMESPACE=default
SSH_STAGING_KUBECTL=sudo -n kubectl
